{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "files": {
    "includes": ["board/**/*.js", "board/**/*.html"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedVariables": "warn"
      },
      "suspicious": {
        "useIterableCallbackReturn": "warn"
      },
      "style": {
        "useTemplate": "off"
      },
      "complexity": {
        "useOptionalChain": "off",
        "noImportantStyles": "off"
      },
      "a11y": {
        "useButtonType": "off",
        "useMediaCaption": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    },
    "globals": ["WebSocket", "fetch", "document", "window", "requestAnimationFrame"]
  }
}
